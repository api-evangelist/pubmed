                  "key": "db",
                  "value": "<string>",
                  "description": "Target database. Omit to return a list of all valid Entrez databases."
                },
                {
                  "disabled": false,
                  "key": "version",
                  "value": "<string>",
                  "description": "Set to '2.0' for EInfo XML version 2.0 with additional field attributes."
                },
