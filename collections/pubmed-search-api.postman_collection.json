        {
          "id": "a84f9690-bff8-4cc3-873c-affa06e8bc74",
          "name": "ESpell - Retrieve spelling suggestions",
          "request": {
            "name": "ESpell - Retrieve spelling suggestions",
            "description": {
              "content": "Retrieves spelling suggestions for search terms in a given Entrez database.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "espell.fcgi"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "db",
                  "value": "<string>",
                  "description": "(Required) Database to check spelling suggestions against."
                },
                {
                  "disabled": false,
                  "key": "term",
                  "value": "<string>",
                  "description": "(Required) Search term to check for spelling suggestions (URL encoded)."
                },
                {
                  "disabled": false,
                  "key": "tool",
                  "value": "<string>",
                  "description": "Name of application making the call."
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "Contact email address."
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "API key to enable higher request rate."
