        {
          "id": "1fb11d24-a82a-4e04-bb23-a80d815e33ee",
          "name": "ECitMatch - Match citations to PubMed IDs",
          "request": {
            "name": "ECitMatch - Match citations to PubMed IDs",
            "description": {
              "content": "Retrieves PubMed IDs (PMIDs) that correspond to a set of input citation strings. Each citation string must include journal, year, volume, page, author name, and a user-assigned key.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ecitmatch.cgi"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "db",
                  "value": "<string>",
                  "description": "(Required) Only 'pubmed' is supported."
                },
                {
                  "disabled": false,
                  "key": "bdata",
                  "value": "<string>",
                  "description": "(Required) Citation strings formatted as: journal|year|volume|page|author|key|, separated by %0D (encoded newlines)."
                },
                {
                  "disabled": false,
                  "key": "retmode",
                  "value": "<string>",
                  "description": "Response format (xml)."
                },
                {
                  "disabled": false,
                  "key": "tool",
                  "value": "<string>",
                  "description": "Name of application making the call."
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "Contact email address."
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "API key to enable higher request rate."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
