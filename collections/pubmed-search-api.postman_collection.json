            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "8e4d9359-a361-416f-849b-e2013152a93c",
              "name": "Spelling suggestions",
              "originalRequest": {
                "url": {
                  "path": [
                    "espell.fcgi"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "db",
                      "value": "pubmed"
                    },
                    {
                      "key": "term",
                      "value": "asthmaa"
                    },
                    {
                      "key": "tool",
                      "value": "<string>"
                    },
                    {
                      "key": "email",
                      "value": "<email>"
                    },
                    {
                      "key": "api_key",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/xml"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/xml"
                }
              ],
              "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <espellresult>\n    <database>(string)</database>\n    <query>(string)</query>\n    <correctedquery>(string)</correctedquery>\n    <spelledquery>\n      <replaced>\n        <position>(string)</position>\n        <text>(string)</text>\n      </replaced>\n      <replaced>\n        <position>(string)</position>\n        <text>(string)</text>\n      </replaced>\n    </spelledquery>\n  </espellresult>\n</element>",
              "cookie": [],
              "_postman_previewlanguage": "xml"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
