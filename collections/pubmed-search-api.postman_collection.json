{
  "item": [
    {
      "id": "1df4f9bd-1a52-4960-9dde-61b4b06b97fe",
      "name": "Search",
      "description": {
        "content": "Operations for searching Entrez databases",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "be75d90f-9787-4984-9f91-91b3fceb5012",
          "name": "ESearch - Search a database",
          "request": {
            "name": "ESearch - Search a database",
            "description": {
              "content": "Performs a text query search in a single Entrez database and retrieves a list of matching UIDs (unique identifiers). Results can be stored on the Entrez History server for later use with other E-utilities.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "esearch.fcgi"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "db",
                  "value": "<string>",
                  "description": "(Required) Database to search. Common values: pubmed, pmc, gene, nucleotide, protein, assembly, biosample."
                },
                {
                  "disabled": false,
                  "key": "term",
                  "value": "<string>",
                  "description": "(Required) Entrez text query (URL encoded). Spaces may be replaced by '+' signs. Can include field tags like [Author] or [MeSH Terms]."
                },
                {
                  "disabled": false,
                  "key": "retstart",
                  "value": "0",
                  "description": "Sequential index of the first UID in the retrieved set (default: 0)."
                },
                {
                  "disabled": false,
                  "key": "retmax",
                  "value": "20",
                  "description": "Total number of UIDs to retrieve (default: 20, max: 100000)."
                },
                {
                  "disabled": false,
                  "key": "rettype",
                  "value": "uilist",
                  "description": "Retrieval type. Values: uilist (default), count."
                },
                {
                  "disabled": false,
                  "key": "retmode",
                  "value": "xml",
                  "description": "Response format. Values: xml (default), json."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sort order for results."
                },
                {
                  "disabled": false,
                  "key": "field",
                  "value": "<string>",
                  "description": "Limit search to specified field (e.g., Author, Title, MeSH Terms)."
                },
                {
                  "disabled": false,
                  "key": "datetype",
                  "value": "<string>",
                  "description": "Type of date to limit the search. Values: mdat (modification date), pdat (publication date), edat (Entrez date)."
                },
                {
                  "disabled": false,
                  "key": "reldate",
                  "value": "<integer>",
                  "description": "Limit results to items published in the last n days."
                },
                {
                  "disabled": false,
                  "key": "mindate",
                  "value": "<string>",
                  "description": "Minimum date for date range filter (YYYY/MM/DD, YYYY/MM, or YYYY)."
                },
                {
                  "disabled": false,
                  "key": "maxdate",
                  "value": "<string>",
                  "description": "Maximum date for date range filter (YYYY/MM/DD, YYYY/MM, or YYYY)."
                },
                {
                  "disabled": false,
                  "key": "usehistory",
                  "value": "<string>",
                  "description": "Set to 'y' to store results on the Entrez History server for use in subsequent calls."
                },
                {
                  "disabled": false,
                  "key": "WebEnv",
                  "value": "<string>",
                  "description": "Web environment string returned from a previous ESearch, EPost, or ELink call."
                },
                {
                  "disabled": false,
                  "key": "query_key",
                  "value": "<integer>",
                  "description": "Integer query key returned by a previous ESearch, EPost, or ELink call."
                },
                {
                  "disabled": false,
                  "key": "tool",
                  "value": "<string>",
                  "description": "Name of application making the call (no spaces). Recommended."
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "Contact email address. Recommended for NCBI to contact in case of problems."
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "API key to enable up to 10 requests/second (vs 3 req/s without key)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "b3492442-91ee-4c2e-ac72-9c3d84971d6a",
              "name": "Successful search response with UIDs",
              "originalRequest": {
                "url": {
                  "path": [
                    "esearch.fcgi"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "db",
                      "value": "pubmed"
                    },
                    {
                      "key": "term",
                      "value": "cancer[MeSH Terms]"
                    },
                    {
                      "key": "retstart",
                      "value": "0"
                    },
                    {
                      "key": "retmax",
                      "value": "20"
                    },
                    {
                      "key": "rettype",
                      "value": "uilist"
                    },
                    {
                      "key": "retmode",
                      "value": "xml"
                    },
                    {
                      "key": "sort",
                      "value": "<string>"
                    },
                    {
                      "key": "field",
                      "value": "<string>"
                    },
                    {
                      "key": "datetype",
                      "value": "<string>"
                    },
                    {
                      "key": "reldate",
                      "value": "<integer>"
                    },
                    {
                      "key": "mindate",
                      "value": "2020/01/01"
                    },
                    {
                      "key": "maxdate",
                      "value": "2025/12/31"
                    },
                    {
                      "key": "usehistory",
                      "value": "<string>"
                    },
                    {
                      "key": "WebEnv",
                      "value": "<string>"
                    },
                    {
                      "key": "query_key",
                      "value": "<integer>"
                    },
                    {
                      "key": "tool",
                      "value": "<string>"
                    },
                    {
                      "key": "email",
                      "value": "<email>"
                    },
                    {
                      "key": "api_key",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"esearchresult\": {\n    \"count\": \"string\",\n    \"retmax\": \"string\",\n    \"retstart\": \"string\",\n    \"querykey\": \"string\",\n    \"webenv\": \"string\",\n    \"idlist\": [\n      \"string\",\n      \"string\"\n    ],\n    \"querytranslation\": \"string\"\n  }\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
