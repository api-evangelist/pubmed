          "id": "89574dfa-538d-4b6e-8ecf-1d71558e3348",
          "name": "ESummary - Retrieve document summaries",
          "request": {
            "name": "ESummary - Retrieve document summaries",
            "description": {
              "content": "Returns document summaries (DocSums) for a list of input UIDs or for a set of UIDs stored on the Entrez History server.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "esummary.fcgi"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "db",
                  "value": "<string>",
                  "description": "(Required) Database containing the UIDs (e.g., pubmed, gene, assembly)."
                },
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "Comma-delimited list of UIDs."
                },
                {
                  "disabled": false,
                  "key": "retstart",
                  "value": "1",
                  "description": "Sequential index of first DocSum to retrieve (default: 1)."
                },
                {
                  "disabled": false,
                  "key": "retmax",
                  "value": "<integer>",
                  "description": "Number of DocSums to retrieve (max: 10000)."
                },
                {
                  "disabled": false,
                  "key": "retmode",
                  "value": "xml",
                  "description": "Response format. Values: xml (default), json."
                },
                {
                  "disabled": false,
                  "key": "version",
                  "value": "<string>",
                  "description": "Set to '2.0' to use version 2.0 ESummary XML with database-specific fields."
                },
                {
                  "disabled": false,
                  "key": "WebEnv",
                  "value": "<string>",
                  "description": "Web environment string from a previous ESearch, EPost, or ELink call."
                },
                {
                  "disabled": false,
                  "key": "query_key",
                  "value": "<integer>",
                  "description": "Integer query key from a previous call."
                },
                {
                  "disabled": false,
                  "key": "tool",
                  "value": "<string>",
                  "description": "Name of application making the call."
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "Contact email address."
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "API key to enable higher request rate."
                }
              ],
              "variable": []
            },
