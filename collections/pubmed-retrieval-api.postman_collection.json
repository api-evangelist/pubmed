      "item": [
        {
          "id": "0995b638-1863-4e13-bffc-f51dbe2ec321",
          "name": "EFetch - Retrieve full records",
          "request": {
            "name": "EFetch - Retrieve full records",
            "description": {
              "content": "Retrieves full records in a specified format for a list of input UIDs from an Entrez database. Supports multiple return types and modes depending on the target database.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "efetch.fcgi"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "db",
                  "value": "<string>",
                  "description": "(Required) Database from which to retrieve records (e.g., pubmed, nucleotide, protein, gene)."
                },
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "Comma-delimited list of UIDs to retrieve."
                },
                {
                  "disabled": false,
                  "key": "retstart",
                  "value": "0",
                  "description": "Sequential index of the first record to retrieve (default: 0)."
                },
                {
                  "disabled": false,
                  "key": "retmax",
                  "value": "20",
                  "description": "Number of records to retrieve (default: 20, max: 10000)."
                },
                {
                  "disabled": false,
                  "key": "rettype",
                  "value": "<string>",
                  "description": "Retrieval type. For PubMed: abstract, medline, uilist, docsum. For sequences: fasta, gb, gp."
                },
                {
                  "disabled": false,
                  "key": "retmode",
                  "value": "<string>",
                  "description": "Retrieval mode. Values: xml, text, asn.1."
                },
                {
                  "disabled": false,
                  "key": "WebEnv",
                  "value": "<string>",
                  "description": "Web environment string from a previous ESearch, EPost, or ELink call."
                },
                {
                  "disabled": false,
                  "key": "query_key",
                  "value": "<integer>",
                  "description": "Integer query key from a previous ESearch, EPost, or ELink call."
                },
                {
                  "disabled": false,
                  "key": "tool",
                  "value": "<string>",
                  "description": "Name of application making the call (no spaces). Recommended."
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "Contact email address. Recommended."
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "API key to enable up to 10 requests/second."
                }
              ],
