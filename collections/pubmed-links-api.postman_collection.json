      "name": "Links",
      "description": {
        "content": "Operations for finding linked records between databases",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "acb98f4f-35dc-4fdb-99a2-dd6e701b40e7",
          "name": "ELink - Retrieve linked records",
          "request": {
            "name": "ELink - Retrieve linked records",
            "description": {
              "content": "Returns UIDs linked to an input set of UIDs in either the same database or a different Entrez database. Also returns LinkOut URLs for non-Entrez external resources, and checks for the existence of links in either direction.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "elink.fcgi"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "dbfrom",
                  "value": "<string>",
                  "description": "(Required) Database containing the input UIDs."
                },
                {
                  "disabled": false,
                  "key": "db",
                  "value": "<string>",
                  "description": "Database to search for linked records. Omit when cmd is llinks or llinkslib."
                },
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "Comma-delimited list of UIDs."
                },
                {
                  "disabled": false,
                  "key": "cmd",
                  "value": "neighbor",
                  "description": "(Required) ELink command mode."
                },
                {
                  "disabled": false,
                  "key": "linkname",
                  "value": "<string>",
                  "description": "Name of a specific link to retrieve (e.g., pubmed_pubmed, pubmed_pmc)."
                },
                {
                  "disabled": false,
                  "key": "term",
                  "value": "<string>",
                  "description": "Entrez query to filter linked UIDs."
                },
                {
                  "disabled": false,
                  "key": "retmode",
                  "value": "xml",
                  "description": "Response format (xml or json)."
                },
                {
                  "disabled": false,
                  "key": "holding",
                  "value": "<string>",
                  "description": "Name of a LinkOut provider to restrict LinkOut links."
                },
                {
                  "disabled": false,
                  "key": "datetype",
                  "value": "<string>",
                  "description": "Type of date to limit the link results."
                },
                {
                  "disabled": false,
                  "key": "reldate",
                  "value": "<integer>",
                  "description": "Limit results to items published in the last n days."
                },
                {
                  "disabled": false,
                  "key": "mindate",
                  "value": "<string>",
                  "description": "Minimum date for date range filter."
                },
                {
                  "disabled": false,
                  "key": "maxdate",
                  "value": "<string>",
                  "description": "Maximum date for date range filter."
                },
                {
                  "disabled": false,
